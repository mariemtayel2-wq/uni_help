rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // 1. University IDs
    // =====================================================
    // متاحة للقراءة حتى قبل تسجيل الدخول
    // لاستخدامها أثناء Login / Register
    match /university_ids/{universityId} {
      allow read: if true;

      allow create: if request.auth != null;

      allow update, delete: if false;
    }


    // =====================================================
    // 2. Users
    // =====================================================
    match /users/{userId} {

      // المستخدم المسجل يقدر يقرأ بيانات المستخدمين
      allow read: if request.auth != null;

      // كل User يعدل بياناته فقط
      allow create, update: if request.auth != null
        && request.auth.uid == userId;


      // ---------------------------------------------------
      // User Notifications
      // /users/{userId}/notifications/{notificationId}
      // ---------------------------------------------------
      match /notifications/{notificationId} {

        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['isRead']);

        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }


    // =====================================================
    // 3. Requests
    // =====================================================
    match /requests/{requestId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null;

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;


      // ---------------------------------------------------
      // 4. Offers
      // ---------------------------------------------------
      match /offers/{offerId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null;

        allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }


    // =====================================================
    // 5. Chats
    // =====================================================
    match /chats/{chatId} {

      // يسمح بفحص Chat غير موجود قبل إنشائه، وقراءة الموجود للمشاركين فقط
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
          || (resource.data.participants is list
            && request.auth.uid in resource.data.participants));

      allow list: if request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;


      // إنشاء Chat
      // لازم المستخدم اللي أنشأ الـ Chat يكون Participant
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;


      // تعديل الـ Chat للمشاركين فقط
      allow update: if request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;


      // حذف الـ Chat للمشاركين فقط
      allow delete: if request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;


      // ===================================================
      // Messages
      // ===================================================
      match /messages/{messageId} {

        // -----------------------------------------------
        // Read Message
        // -----------------------------------------------
        allow read: if request.auth != null
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants is list
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;


        // -----------------------------------------------
        // Create Message
        // -----------------------------------------------
        allow create: if request.auth != null

          // المستخدم لازم يكون Participant
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants is list

          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants

          // senderId لازم يكون نفس الشخص اللي عامل الطلب
          && request.resource.data.senderId == request.auth.uid;


        // -----------------------------------------------
        // Update Message
        // -----------------------------------------------
        allow update: if request.auth != null

          // صاحب الرسالة فقط
          && resource.data.senderId == request.auth.uid

          // ولازم يكون Participant
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants is list

          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;


        // -----------------------------------------------
        // Delete Message
        // -----------------------------------------------
        allow delete: if request.auth != null

          // صاحب الرسالة فقط
          && resource.data.senderId == request.auth.uid

          // ولازم يكون Participant
          && get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants is list

          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;
      }
    }


    // =====================================================
    // 6. Notifications
    // =====================================================
    match /notifications/{notificationId} {

      // المستقبل يقرأ الإشعار
      allow read: if request.auth != null
        && resource.data.receiverId == request.auth.uid;


      // إنشاء Notification
      allow create: if request.auth != null;


      // المستقبل يقدر يعمل Update
      allow update: if request.auth != null
        && resource.data.receiverId == request.auth.uid;


      // المستقبل يقدر يحذف الإشعار
      allow delete: if request.auth != null
        && resource.data.receiverId == request.auth.uid;
    }
  }
}